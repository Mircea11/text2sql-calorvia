# À copier dans text2sql/.env ; ne pas écraser le .env du RAG.
# Les valeurs CALORVIA_LLM_BASE_URL / CALORVIA_LLM_MODEL existantes sont réutilisées.
T2SQL_API_KEY=
T2SQL_SOURCE_PASSWORD=
# Le fichier Compose fourni publie réellement SQL Server sur 14330 (guide : 1433).
T2SQL_ERP_PORT=14330
T2SQL_COMPTA_PORT=5433
T2SQL_PAIE_PORT=5434
# Journal existant, compte écrivain distinct de agent_ro, base locale du cours.
T2SQL_JOURNAL_DSN=
# Sans DSN, réutilisation du transport local Docker déjà présent dans calorvia_tools.py.
T2SQL_JOURNAL_CONTAINER=helpdesk-ops-postgres-1
T2SQL_MAX_ROWS=200
T2SQL_TIMEOUT_S=30
T2SQL_MAX_STEPS=18
# Serveur NVIDIA local, endpoint API backend (ne démarre aucun modèle).
T2SQL_AUTO_ONTOLOGY_URL=http://127.0.0.1:3001
T2SQL_AUTO_ONTOLOGY_TOKEN=
